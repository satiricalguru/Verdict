FROM node:20-alpine AS base

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

COPY . .

RUN npx prisma generate
RUN npm run build

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

# Initialize the SQLite database from the seeded market feed, then serve.
CMD ["sh", "-c", "npx prisma db push --skip-generate && npm run db:seed && npm run start"]
